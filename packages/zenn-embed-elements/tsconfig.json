{
  "compilerOptions": {
    "target": "es6", // important for web components
    "module": "node16",
    "declaration": true,
    "outDir": "./lib",
    "rootDir": "./src",
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "lib"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
